---
import SEO, { type Breadcrumb } from '../components/layout/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ProvaModal from '../components/ProvaModal.astro';
import AccountModal from '../components/AccountModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
  ogTitle?: string;
  /* Per le landing page a canale unico (es. /referral, aperta da un
     link WhatsApp o da un QR code): niente header né footer, cosi'
     chi arriva non trova una via d'uscita verso il resto del sito. Il
     resto della pagina (Hero, tracking, ProvaModal/AccountModal) resta
     invariato — sono "chrome" di navigazione, non contenuto. */
  hideChrome?: boolean;
}

const { title, description, ogImage, noindex, breadcrumbs, ogTitle, hideChrome } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Font di titolo (Anton) autoospitato: scoperto tardi, solo dopo che il
        browser ha letto il CSS e trovato la @font-face. Il preload lo fa
        partire subito, in parallelo all'HTML, cosi' il testo dei titoli
        (praticamente sempre above-the-fold) passa dal fallback al font
        definitivo prima. crossorigin e' richiesto anche se il font e'
        sulla stessa origine: i font vengono sempre richiesti in modalita'
        CORS anonima, senza si rischia un doppio download. */}
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Le connessioni verso i due domini esterni caricati piu' sotto
        (script bloccanti/eseguiti su ogni pagina): risolvere DNS/TLS in
        anticipo toglie quel tempo dalla richiesta vera e propria. Niente
        preconnect per gli altri servizi esterni del sito (mappe, form,
        PerfectGym, Typeform): sono iframe lazy o link di navigazione, non
        risorse che servono nei primi secondi di questa pagina. */}
    <link rel="preconnect" href="https://cdn-cookieyes.com" />
    <link rel="preconnect" href="https://connect.facebook.net" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google Consent Mode v2 - stato di default -->
    {/* Deve eseguire PRIMA di CookieYes: definisce gtag/dataLayer e nega
        tutto finche' non arriva un consenso esplicito. wait_for_update da'
        a CookieYes fino a 500ms per mandare il suo aggiornamento di consenso
        prima che gli Google tag (caricati dopo, via GTM) decidano se sparare
        o no. is:inline per lo stesso motivo del blocco CookieYes sotto:
        Astro trasformerebbe altrimenti lo script in un modulo differito,
        che partirebbe DOPO CookieYes invece che prima. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
    </script>
    <!-- End Google Consent Mode v2 -->

    <!-- Start cookieyes banner -->
    {/* Primo script della pagina, prima del Meta Pixel: CookieYes blocca gli
        script di tracciamento fino al consenso, quindi deve caricarsi per
        primo. is:inline lo lascia com'e' (Astro lo trasformerebbe in un
        modulo differito, che partirebbe dopo il pixel). */}
    <script
      is:inline
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/c9442574ff0ef76a81383b99/script.js"></script>
    <!-- End cookieyes banner -->

    <!-- Google Tag Manager -->
    {/* Subito dopo CookieYes: il container GTM-N68BT5M8 e' lo stesso gia' in
        uso sul vecchio sito WordPress (via Site Kit), riportato identico per
        continuita' storica dei dati. GA4 e' installato DIRETTO (vedi blocco
        gtag.js subito sotto), non come tag dentro questo container: scelta
        esplicita per evitare la doppia configurazione, i due metodi si
        escludono a vicenda. */}
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-N68BT5M8');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) - GA4 diretto -->
    {/* Installazione diretta scelta invece che dentro GTM: stesso Measurement
        ID gia' in uso sul vecchio sito WordPress (via Site Kit), riportato
        identico per continuita' storica dei dati. Rispetta lo stesso Consent
        Mode dichiarato in cima (default negato finche' CookieYes non
        aggiorna il consenso) senza bisogno di ripeterlo: gtag/dataLayer sono
        gia' definiti da quel blocco, gtag('js', ...) e gtag('config', ...)
        si limitano ad accodarsi alla stessa coda. is:inline su entrambi:
        devono restare script classici nell'ordine in cui sono scritti, non
        diventare moduli differiti. */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N9QTHSFRXY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-N9QTHSFRXY');
    </script>
    <!-- End Google tag (gtag.js) -->

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} breadcrumbs={breadcrumbs} ogTitle={ogTitle} />

    <!-- Meta Pixel Code -->
    {/* is:inline: lo snippet di terze parti resta esattamente com'e' (script
        classico, eseguito subito). Senza, Astro lo trasforma in
        type="module", che viene differito a fine parsing. */}
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '3335065516761738');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" alt=""
        src="https://www.facebook.com/tr?id=3335065516761738&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N68BT5M8"
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    {!hideChrome && <Header />}
    <main>
      <slot />
    </main>
    {!hideChrome && <Footer />}

    {/* Il form della prova: presente su ogni pagina perche' le CTA che lo
        aprono sono su ogni pagina — header compreso. Sta in fondo al body e
        non nell'header cosi' il suo markup non entra nel primo schermo. */}
    <ProvaModal />

    {/* L'altra meta' del sito: quello che serve a chi e' gia' socio. Lo apre
        l'omino nell'header e il pulsante nell'hero della home. */}
    <AccountModal />
  </body>
</html>

<script>
  // Reveal allo scroll condiviso: qualsiasi elemento con data-reveal riceve
  // .is-visible al primo ingresso in viewport (una volta sola). Il movimento
  // (direzione, fade, ecc.) lo definisce il CSS del singolo componente.
  function initScrollReveal() {
    const els = document.querySelectorAll('[data-reveal]');
    if (!els.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
    );

    els.forEach((el) => observer.observe(el));
  }

  initScrollReveal();

  // Parallasse: il riquadro (data-parallax) resta fermo nel flusso della
  // pagina, l'immagine al suo interno (piu' alta del riquadro, vedi CSS del
  // componente) scorre verticalmente in base a quanto la pagina e' stata
  // scrollata rispetto al riquadro stesso.
  function initParallax() {
    const media = document.querySelectorAll('[data-parallax]');
    if (!media.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Il filtro scarta i riquadri senza immagine (es. quelli col video):
    // `flatMap` invece di `map`+`filter` perche' cosi' il tipo di `img` resta
    // non nullo anche dopo il filtro.
    const items = Array.from(media).flatMap((el) => {
      const img = el.querySelector('img');
      return img ? [{ el, img }] : [];
    });
    if (!items.length) return;

    let queued = false;
    function update() {
      const vh = window.innerHeight;
      items.forEach(({ el, img }) => {
        const rect = el.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) return; // fuori viewport, non serve calcolare
        // 0 quando il riquadro entra dal basso, 1 quando esce dall'alto.
        const progress = (vh - rect.top) / (vh + rect.height);
        const clamped = Math.min(1, Math.max(0, progress));
        const range = rect.height * 0.15; // combacia con l'eccesso del 15% in CSS
        const offset = (clamped - 0.5) * range * 2;
        img.style.transform = `translateY(${offset}px)`;
      });
      queued = false;
    }
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  initParallax();

  // Link esterni in una scheda nuova.
  //
  // Fatto qui e non sui singoli `href` perche' la maggior parte dei link
  // esterni del sito nasce dal markdown delle pagine in `content/pages`, dove
  // non si possono mettere attributi: PerfectGym, le mappe, i loghi dei
  // consorzi, i PDF ospitati altrove. Un giro solo sul documento li copre
  // tutti, comprese le pagine che verranno.
  //
  // `rel` accanto a `target`: senza `noopener` la pagina aperta puo' toccare
  // `window.opener`, e con `_blank` e' una vulnerabilita', non un dettaglio.
  // Chi ha gia' un `target` scritto a mano resta com'e'.
  function initLinkEsterni() {
    document.querySelectorAll('a[href]').forEach((a) => {
      const link = a as HTMLAnchorElement;
      if (link.target) return;
      // `mailto:`, `tel:`, `#ancora` e i percorsi interni hanno tutti lo
      // stesso host della pagina o un protocollo che non e' http(s).
      if (link.protocol !== 'http:' && link.protocol !== 'https:') return;
      if (link.host === location.host) return;
      link.target = '_blank';
      link.rel = link.rel ? link.rel + ' noopener noreferrer' : 'noopener noreferrer';
    });
  }

  initLinkEsterni();

  // Un solo accordion Collapsible aperto alla volta (es. pagina Abbonamenti):
  // all'apertura di uno, tutti gli altri `.collapsible` della pagina si
  // richiudono. Vive qui e non nel componente Collapsible stesso perche' uno
  // <script> di modulo dentro un componente ripetuto viene deduplicato da
  // Astro ma resta comunque inserito come fratello nel DOM al punto del primo
  // utilizzo, spezzando l'adiacenza diretta tra quel Collapsible e gli
  // elementi vicini su cui contano le regole CSS che azzerano i margini tra
  // fasce che si toccano. Qui invece e' fuori dal flusso delle sezioni.
  function initAccordionEsclusivo() {
    const items = document.querySelectorAll('details.collapsible');
    if (!items.length) return;

    items.forEach((el) => {
      el.addEventListener('toggle', () => {
        if (!(el instanceof HTMLDetailsElement) || !el.open) return;
        items.forEach((other) => {
          if (other !== el) (other as HTMLDetailsElement).open = false;
        });
      });
    });
  }

  initAccordionEsclusivo();
</script>
