---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Button from '../components/ui/Button.astro';
import CtaSplit from '../components/ui/CtaSplit.astro';
import FeatureShowcase from '../components/ui/FeatureShowcase.astro';
import HighlightCards from '../components/ui/HighlightCards.astro';
import StatsBand from '../components/ui/StatsBand.astro';
import ContentRows from '../components/ui/ContentRows.astro';
import ContentRow from '../components/ui/ContentRow.astro';

const STATS = [
  { num: '30+', label: 'Anni nel settore' },
  { num: '2000', label: 'm² dedicati al fitness' },
  { num: '1000', label: 'mq di sala pesi' },
  { num: '2+2', label: 'Sale fitness e studi reformer' },
];

const PROVA_URL =
  'https://automazione.n8ndevelop.it/form/8ce36c5e-0cc4-4813-9a0f-2da2a7605fb0?source=SitoWeb&medium=Btn_Home';
const ABBONAMENTI_URL = 'https://passion.perfectgym.com/clientportal2/#/Registration';
const LOGIN_URL = 'https://passion.perfectgym.com/clientportal2/#/Login';

const QUICKLINKS = [
  {
    title: 'Planning',
    body: "Oltre 250 lezioni al mese tra Rebalance, Energy, Pilates e Reformer, distribuite su più sale e studi dedicati. Consulta gli orari aggiornati in tempo reale e organizza la tua settimana di allenamento in pochi secondi.",
    href: '/orari-corsi/',
    cta: 'Scopri il planning',
    image: '/images/nuove/manubri.jpeg',
  },
  {
    title: 'Abbonamenti',
    body: 'Dalla sala pesi in accesso libero ai pacchetti di Personal Training, fino alle formule Open pensate per chi si allena senza vincoli di orario. Scegli la soluzione più adatta al tuo obiettivo e al tuo budget.',
    href: ABBONAMENTI_URL,
    cta: 'Scopri gli abbonamenti',
    image: '/images/uploads/2024/10/Palestra-11920x.jpg',
  },
  {
    title: 'Prova Open',
    body: "Vieni a scoprire di persona sala pesi, corsi fitness e studi Reformer, senza impegno. Il nostro staff ti guida nella scelta del percorso più adatto a te fin dal primo allenamento.",
    href: PROVA_URL,
    cta: 'Prova ora',
    image: '/images/nuove/manubri2.jpg',
  },
];

---

<BaseLayout
  title="Palestra Roma Tuscolana da oltre 30 anni"
  description="La palestra più grande delle zone Tuscolana, Cinecittà, Don Bosco e San Policarpo: sala pesi, corsi fitness e Reformer, aperti tutti i giorni."
>
  <Hero
    title="PASSION FITNESS"
    video="/videos/hero-provvisorio.mp4"
    image="/images/uploads/2024/10/Palestra-11920x.jpg"
  >
    <p>La palestra più grande delle zone Tuscolana, Cinecittà, Don Bosco e San Policarpo.</p>
    <div class="hero-ctas">
      <Button href={PROVA_URL} variant="white">Prova Passion Fitness</Button>
      {/* La seconda strada dell'hero: chi e' gia' socio non sta cercando una
          prova. `data-acct-open` apre `AccountModal` dal BaseLayout, e l'href
          al login resta come ripiego senza JavaScript. Su telefono le regole
          di `.hero-ctas` in global.css nascondono tutto tranne il primo
          comando, che e' la conversione: questo compare da 860px in su. */}
      <a class="hero-account" href={LOGIN_URL} data-acct-open aria-haspopup="dialog" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        Sono già iscritto
      </a>
    </div>
  </Hero>

  <HighlightCards items={QUICKLINKS} />

  <StatsBand stats={STATS} />

  <ContentRows>
      <ContentRow
        title="Sala Pesi"
        video="/videos/2024/11/Sala-Pesi_Passion-Fitness.mp4"
        alt="Sala pesi Passion Fitness"
      >
        <p>Oltre 95 postazioni con <strong>macchinari Technogym e Panatta di ultima generazione</strong>, pensati per il massimo coinvolgimento muscolare e un allenamento sempre all'avanguardia.</p>
        <p>Aperti <strong>tutti i giorni dalle 5:00 alle 24:00</strong>, anche a Natale e Ferragosto: zona free weight, area calisthenics e area booty training per ogni tipo di allenamento.</p>
        <Button href="/palestra/sala-pesi/" variant="white">Vai alla Sala Pesi</Button>
      </ContentRow>

      <ContentRow
        title="Corsi Fitness"
        video="/videos/2025/02/Metcon-2.mp4"
        alt="Corsi fitness Passion Fitness"
      >
        <p><strong>2 sale dedicate</strong>, corsi dalle 7:00 alle 21:30: oltre 120 ore mensili di lezioni <strong>Rebalance</strong> (Pilates, Pilates Barre, Posturale, Yoga) per lavorare su mobilità e postura.</p>
        <p>A queste si aggiungono oltre 130 ore di lezioni <strong>Energy</strong> (Pump, Met-Con, Prepugilistica, Funzionale, Booty Pump), per chi cerca un allenamento più intenso e dinamico.</p>
        <Button href="/palestra/corsi-fitness/" variant="white">Vai ai Corsi Fitness</Button>
      </ContentRow>

      <ContentRow
        title="Personal Training"
        video="/videos/2024/11/I-love-my-trainer-2.mp4"
        alt="Personal training Passion Fitness"
      >
        <p>Con il <strong>Personal Training</strong> alleni fianco a fianco con un trainer dedicato, che ti segue in ogni sessione con una <strong>Programmazione Dinamica dell'Allenamento</strong> aggiornata ogni settimana.</p>
        <p>Un percorso su misura, pensato per chi vuole risultati concreti con la massima attenzione e personalizzazione.</p>
        <Button href="/personal-training/" variant="white">Vai al Personal Training</Button>
      </ContentRow>

      <ContentRow
        title="Reformer"
        video="/videos/2024/10/reformer_senza_testi.mp4"
        alt="Pilates Reformer Passion Fitness"
      >
        <p><strong>3 sale interamente dedicate al Reformer</strong>: Studio Reformer per chi inizia, Studio Reformer Plus per livelli intermedi e avanzati.</p>
        <p>Studio PT Reformer per lezioni individuali con <strong>Reformer, Cadillac e Chair</strong>.</p>
        <Button href="/pilates-reformer/" variant="white">Vai al Reformer</Button>
      </ContentRow>
    </ContentRows>

  <FeatureShowcase
    title="Perché scegliere noi?"
    images={[
      { src: '/images/nuove/personaltrainer.webp', alt: 'Personal training Passion Fitness' },
      { src: '/images/nuove/reformer-scaled.jpeg', alt: 'Studio Pilates Reformer' },
      { src: '/images/nuove/salapesi.jpg', alt: 'Sala pesi Passion Fitness' },
      { src: '/images/nuove/bilanciere.jpg', alt: 'Allenamento con bilanciere' },
      { src: '/images/nuove/manubri3.jpg', alt: 'Allenamento con manubri' },
      { src: '/images/nuove/boxe.jpg', alt: 'Area boxing Passion Fitness' },
    ]}
    features={[
      '30+ anni di esperienza nel settore',
      "La persona sempre al centro, prima dell'allenamento",
      "Tutta l'attenzione che meriti, ad ogni allenamento",
      'Ti alleniamo al tuo fianco, finché non acquisirai piena sicurezza',
    ]}
  >
    <CtaSplit
      slot="cta"
      heading="Pronto a iniziare?"
      text="Vieni a scoprire Passion Fitness, senza impegno."
      buttonLabel="Prova Passion Fitness"
      buttonHref={PROVA_URL}
      image="/images/uploads/2024/11/MRZ08075.jpeg"
      alt="Passion Fitness Tuscolana"
    />
  </FeatureShowcase>
</BaseLayout>

<style>
  /* Le regole di .hero-ctas (dimensioni, zoom in hover, CTA unica su
     mobile) vivono in global.css: valgono per la home e per le pagine che
     passano heroCtas da frontmatter. */

  /* Solo sulla home: il logo nell'header gia' mostra il brand, quindi su
     mobile il titolo "Passion Fitness" nell'hero e' ridondante e va nascosto.
     Le altre pagine che usano Hero con video (PageLayout) non hanno questa
     ridondanza e devono invece mostrare il titolo. */
  /* + totem: vedi «Il totem verticale del club» in styles/global.css */
  @media (max-width: 860px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    :global(.hero:has(.hero-media) .hero-title-group) {
      display: none;
    }
  }

  /* La fascia "programmi" e la sua veste (nessun bordo, sfumature tra
     media e testo, CTA come solo testo) vivono in ContentRow/ContentRows:
     stesso risultato su tutte le pagine, senza CSS di pagina. */

  /* La fascia logo + numeri (stats-band) vive in StatsBand.astro: stesso
     risultato ovunque venga riusata, senza CSS di pagina. */
</style>

<style>
  /* Lo stesso vestito di `Button.astro` variante «white», ma con l'omino
     davanti e il fondo trasparente: nell'hero i due comandi non devono pesare
     uguale — la prova e' la conversione, questo e' la scorciatoia per chi
     c'e' gia'. Riscritto qui e non passato a `Button` perche' quel componente
     non ha una variante con icona, e aggiungerne una per un solo uso
     significherebbe una `prop` in piu' in tutte le sue chiamate. */
  .hero-account {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1rem, 1.15vw, 1.2rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1.1rem 2.2rem;
    color: var(--color-white);
    background: transparent;
    border: 4px solid var(--color-white);
    border-radius: 12px;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 0.25s ease, color 0.25s ease;
  }
  .hero-account:hover {
    transform: scale(1.06);
    background: var(--color-white);
    color: var(--text-on-light);
  }

  /* Su telefono `global.css` nasconde tutte le CTA dell'hero tranne la prima,
     perche' due comandi grandi affiancati su uno schermo stretto non sono
     piu' un gesto principale. Qui si rimette in piedi solo questo, e piccolo:
     il selettore ripete `.hero-ctas >` non per abitudine ma per specificita' —
     la regola globale che lo nasconde ne ha piu' di `.hero-account` da solo,
     e senza il genitore la riga non avrebbe alcun effetto. */
  @media (max-width: 860px) {
    /* I due comandi uno sopra l'altro, e la regola sta sul **contenitore**.
       Sui figli non avrebbe funzionato: `.hero-ctas > a` scritto qui diventa
       `a:first-child[data-astro-cid-di-questa-pagina]`, ma quell'`<a>` lo
       stampa `Button.astro` e porta lo scope suo — il selettore non trova
       nulla. Il contenitore invece e' markup di questa pagina, e a lui lo
       scope ce l'ha. In colonna il `width: 100%` che `global.css` da' al
       primo comando torna a valere per intero, e «Prova Passion Fitness»
       non si spezza piu' su tre righe. */
    .hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-ctas > .hero-account {
      display: inline-flex;
      align-self: flex-start;
      /* Su una riga sola: a 118px «Sono gia' iscritto» andava a capo e il
         comando piccolo tornava alto come quello grande. */
      white-space: nowrap;
      font-size: 0.72rem;
      letter-spacing: 0.05em;
      padding: 0.6rem 1.1rem;
      gap: 0.4rem;
      border-width: 2px;
      border-radius: 10px;
    }
    /* Piccolo com'e', lo zoom in hover non ha piu' senso — e su un telefono
       l'hover non esiste: resta solo il rischio che il tocco lo faccia
       sobbalzare. */
    .hero-ctas > .hero-account:hover {
      transform: none;
    }
    .hero-ctas > .hero-account svg {
      width: 14px;
      height: 14px;
    }
  }
</style>
