---
/**
 * Il form «Presenta un Amico», incorporato nella pagina /referral.
 *
 * Diversamente da `ProvaModal.astro` non e' un modale aperto da una CTA
 * altrove nel sito: qui il form E' la pagina, quindi vive incorporato in
 * fondo a /referral invece che in un pannello sovrapposto. La logica a due
 * passi (email → verifica → amici → invio) e i webhook sono gli stessi
 * principi della Prova Passion, spiegati in `data/referral.ts` e
 * `lib/referralForm.client.js`.
 *
 * Il sito non parla mai con PerfectGym ne' con Airtable: manda due POST a
 * n8n. Nessuna chiave nel browser, nessuna route server.
 */
import { GUEST_PASS, MAX_AMICI } from '../data/referral';
import CampoTelefono from './CampoTelefono.astro';

const NUMERI_AMICO = Array.from({ length: MAX_AMICI }, (_, i) => i + 1);
---

<div class="rf" id="referral-form">
  {/* ── 1. L'email di chi invita ───────────────────────────────────────── */}
  <section class="rf__step" id="rf-step-email">
    <span class="rf__eyebrow">Presenta un Amico</span>
    <h3 class="rf__title" tabindex="-1" data-rf-fuoco>Inizia dalla tua email.</h3>
    <p class="rf__lead">
      Controlliamo che tu sia socio, poi ti chiediamo i dati di chi vuoi invitare — fino a {MAX_AMICI}{' '}
      amici in un solo invio.
    </p>

    <label class="rf__label" for="rf-email">La tua email</label>
    <input class="rf__input" id="rf-email" type="email" inputmode="email" autocomplete="email" placeholder="mario.rossi@email.it" />

    <p class="rf__errore" data-rf-errore hidden></p>

    <button type="button" class="rf__btn" data-rf-verifica>
      <span class="rf__btn-testo">Continua</span>
      <span class="rf__spinner" aria-hidden="true"></span>
    </button>
  </section>

  {/* ── 2a. Non risulti socio ──────────────────────────────────────────── */}
  <section class="rf__step" id="rf-step-blocco" hidden>
    <span class="rf__eyebrow">Riservato ai soci</span>
    <h3 class="rf__title" tabindex="-1" data-rf-fuoco>Ci dispiace.</h3>
    <p class="rf__lead">
      Il programma Presenta un Amico e' riservato a chi e' gia' socio di Passion Fitness. Non risultando
      iscritto con questa email, non possiamo far partire l'invito.
    </p>
    <div class="rf__azioni">
      <a class="rf__btn rf__btn--link" href="/abbonamenti/">Vedi gli abbonamenti →</a>
    </div>
  </section>

  {/* ── 2b. I dati degli amici ─────────────────────────────────────────── */}
  <section class="rf__step" id="rf-step-amici" hidden>
    <span class="rf__eyebrow">Ci siamo quasi</span>
    <h3 class="rf__title" tabindex="-1" data-rf-fuoco>Chi vuoi invitare?</h3>
    <p class="rf__lead">
      Regala un Pass di {GUEST_PASS.giorni} giorni a {GUEST_PASS.prezzo}€ (codice {GUEST_PASS.codice}): se il
      tuo amico si iscrive entro la scadenza, tu ricevi un voucher da {GUEST_PASS.voucher}€.
    </p>

    {NUMERI_AMICO.map((n) => (
      <div class="rf__amico" data-rf-amico hidden={n > 1}>
        <p class="rf__amico-titolo">Amico {n}</p>
        <div class="rf__coppia">
          <div>
            <label class="rf__label" for={`rf-amico${n}-nome`}>Nome</label>
            <input class="rf__input" id={`rf-amico${n}-nome`} type="text" autocomplete="off" data-rf-nome placeholder="Nome" />
          </div>
          <div>
            <label class="rf__label" for={`rf-amico${n}-cognome`}>Cognome</label>
            <input class="rf__input" id={`rf-amico${n}-cognome`} type="text" autocomplete="off" data-rf-cognome placeholder="Cognome" />
          </div>
        </div>
        <label class="rf__label" for={`rf-amico${n}-email`}>Email</label>
        <input class="rf__input" id={`rf-amico${n}-email`} type="email" inputmode="email" autocomplete="off" data-rf-email placeholder="amico@email.it" />
        <label class="rf__label" for={`rf-amico${n}-cellulare`}>Cellulare</label>
        <CampoTelefono id={`rf-amico${n}-cellulare`} classe="rf__input" data-rf-cellulare autocomplete="off" />
      </div>
    ))}

    <button type="button" class="rf__btn rf__btn--ghost" data-rf-aggiungi>+ Aggiungi un altro amico</button>

    <label class="rf__consenso" for="rf-privacy">
      <input type="checkbox" id="rf-privacy" />
      <span>
  Acconsento al trattamento dei miei dati e di quelli dei miei amici da parte di Tuscolana SSD Arl
        per l'invio del Pass. <a href="/informativa-privacy" target="_blank" rel="noopener noreferrer">Informativa privacy</a>.
      </span>
    </label>

    <p class="rf__errore" data-rf-errore hidden></p>

    <button type="button" class="rf__btn" data-rf-invia>
      <span class="rf__btn-testo">Invia gli inviti</span>
      <span class="rf__spinner" aria-hidden="true"></span>
    </button>

    <p class="rf__nota">
      Il Pass costa {GUEST_PASS.prezzo}€ (codice {GUEST_PASS.codice}). {GUEST_PASS.condizioni}
    </p>
  </section>

  {/* ── 3. Fatto ────────────────────────────────────────────────────────── */}
  <section class="rf__step" id="rf-step-esito" hidden>
    <span class="rf__eyebrow">Fatto</span>
    <h3 class="rf__title" tabindex="-1" data-rf-fuoco>I tuoi inviti sono partiti.</h3>
    <p class="rf__lead">
      I tuoi amici riceveranno via email e su WhatsApp le istruzioni per attivare il Pass di {GUEST_PASS.giorni}{' '}
      giorni a {GUEST_PASS.prezzo}€ (codice {GUEST_PASS.codice}). Se entro la scadenza si iscrivono, il tuo
      voucher da {GUEST_PASS.voucher}€ arriva in segreteria.
    </p>
  </section>
</div>

<script>
  import { initReferralForm } from '../lib/referralForm.client.js';

  const root = document.getElementById('referral-form');
  if (root) initReferralForm(root);
</script>

<style>
  .rf {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-sm);
    display: flex;
    flex-direction: column;
  }

  .rf__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .rf__step[hidden] {
    display: none;
  }

  .rf__eyebrow {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .rf__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 400;
    line-height: 0.96;
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0;
  }
  .rf__title:focus {
    outline: none;
  }

  .rf__lead {
    font-size: 0.95rem;
    color: var(--text-on-light-muted);
  }

  .rf__label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: var(--space-2xs);
  }

  :global(.rf__input) {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.8rem 1rem;
    color: var(--text-on-light);
    background: var(--bg-light-soft);
    border: 2px solid var(--border-on-light);
    border-radius: 10px;
  }
  :global(.rf__input:focus) {
    outline: none;
    border-color: var(--accent);
  }
  :global(.rf__input--errore) {
    border-color: var(--accent);
    background: var(--color-white);
  }

  .rf__coppia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }
  @media (max-width: 480px) {
    .rf__coppia {
      grid-template-columns: 1fr;
    }
  }

  .rf__amico {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-xs);
    margin-top: var(--space-2xs);
    background: var(--bg-light-soft);
    border-radius: 12px;
  }
  .rf__amico[hidden] {
    display: none;
  }
  .rf__amico-titolo {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .rf__consenso {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-on-light-muted);
    margin-top: var(--space-xs);
  }
  .rf__consenso input {
    margin-top: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
    flex-shrink: 0;
  }
  .rf__consenso a {
    color: var(--accent);
    text-decoration: underline;
  }

  .rf__errore {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  .rf__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    margin-top: var(--space-2xs);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1rem 1.6rem;
    cursor: pointer;
    color: var(--color-white);
    background: var(--accent);
    border: 4px solid var(--accent);
    border-radius: 12px;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .rf__btn:hover {
    background: var(--color-black);
    border-color: var(--color-black);
  }
  .rf__btn[disabled] {
    cursor: progress;
    opacity: 0.75;
  }

  .rf__btn--ghost {
    background: transparent;
    color: var(--accent);
  }
  .rf__btn--ghost:hover {
    background: var(--accent);
    color: var(--color-white);
  }

  .rf__spinner {
    display: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: var(--color-white);
    border-radius: 50%;
    animation: rf-gira 0.7s linear infinite;
  }
  .rf__btn--attesa .rf__spinner {
    display: inline-block;
  }
  @keyframes rf-gira {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rf__spinner {
      animation-duration: 2s;
    }
  }

  .rf__azioni {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: center;
  }
  .rf__btn--link {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }
  .rf__btn--link:hover {
    background: var(--accent);
    color: var(--color-white);
  }

  .rf__nota {
    font-size: 0.78rem;
    color: var(--text-on-light-muted);
  }
</style>
