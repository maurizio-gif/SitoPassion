---
// Fascia richiudibile a piena larghezza (<details> nativo, nessuno script):
// barra nera col titolo sempre visibile, contenuto rivelato al clic. Serve per
// i contenuti secondari di una pagina lunga - nella pagina Abbonamenti tiene
// chiusi Under 25, accessi singoli e pacchetti Personal Training.
//
// A differenza di FaqAccordion (che prende risposte come stringa) il contenuto
// e' slottato: dentro ci vanno altre fasce (es. PricingGroup), che restano a
// piena larghezza perche' qui non c'e' padding orizzontale.
//
// Mutua esclusione: quando se ne apre uno, tutti gli altri `.collapsible`
// della pagina si richiudono da soli - lo gestisce initAccordionEsclusivo()
// in BaseLayout.astro, non uno script qui (vedi il commento li' per il
// perche': uno script per-componente finirebbe comunque nel DOM come
// fratello del <details>, rompendo le regole CSS che azzerano i margini tra
// fasce adiacenti).
//
//   <Collapsible title="Abbonamenti Under 25" variant="accent">
//     <PricingGroup ... />
//   </Collapsible>
interface Props {
  title: string;
  open?: boolean;
  // Ancora per i link diretti alla fascia (usata dal menu mobile).
  id?: string;
  // "accent": barra rossa invece che nera, per farlo risaltare come offerta
  // a se stante rispetto agli altri Collapsible della pagina (es. Under 25).
  variant?: 'default' | 'accent';
}

const { title, open = false, id, variant = 'default' } = Astro.props;
---

<details class:list={['collapsible', { 'collapsible--accent': variant === 'accent' }]} id={id} open={open}>
  <summary class="collapsible__bar">
    {/* .container: il titolo si incolonna con quelli delle altre sezioni e
        con le celle dei blocchi prezzi, che stanno nel container. */}
    <span class="container collapsible__bar-inner">
      <span class="collapsible__title">{title}</span>
      <span class="collapsible__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </span>
    </span>
  </summary>
  <div class="collapsible__body">
    <slot />
  </div>
</details>

<style>
  .collapsible {
    border-block: 2px solid var(--color-black);
    background: var(--color-black);
    /* Aria tra i blocchi, come le fasce prezzi. */
    margin-block: var(--space-sm);
  }
  /* Due fascie consecutive (es. Accessi e Pacchetti + Personal Training) si
     toccano: sono voci dello stesso elenco, non due sezioni distinte. */
  .collapsible + .collapsible {
    margin-top: 0;
  }
  .collapsible:has(+ .collapsible) {
    margin-bottom: 0;
  }
  /* Chiude il gruppo nero avviato da un SectionIntro scuro (es. "Altri
     servizi" + Accessi e pacchetti + Personal Training) con lo stesso respiro
     usato in apertura (il padding-block di .section-intro--dark): senza
     questo, l'ultimo Collapsible della serie si interrompe di colpo appena
     finisce la barra, mentre all'inizio il nero respira per un bel po' prima
     del titolo. Si applica solo all'ultimo della serie (nessun altro
     Collapsible subito dopo) e solo se non e' seguito da un'altra fascia
     nera (altro SectionIntro scuro), che continuerebbe comunque il nero. */
  :global(.collapsible):not(:has(+ .collapsible)):not(:has(+ .section-intro--dark)) {
    padding-bottom: var(--space-xl);
  }
  /* Angoli squadrati e fascia a tutta larghezza: chiusa si legge come le
     altre bande nere del sito (fascia Blog del menu, barra dei giorni). */
  .collapsible__bar {
    display: block;
    padding-block: var(--space-sm);
    background: var(--color-black);
    cursor: pointer;
    list-style: none;
  }
  .collapsible__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .collapsible__bar::-webkit-details-marker {
    display: none;
  }
  .collapsible__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    line-height: 1.1;
    color: var(--color-red);
    transition: color 0.2s ease;
  }
  .collapsible__bar:hover .collapsible__title {
    color: var(--color-white);
  }
  .collapsible__icon {
    flex-shrink: 0;
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-red);
    transition: transform 0.25s ease, color 0.2s ease;
  }
  .collapsible__bar:hover .collapsible__icon {
    color: var(--color-white);
  }
  .collapsible[open] .collapsible__icon {
    transform: rotate(180deg);
  }
  /* Solo su [open]: un `display` dichiarato senza il filtro vincerebbe sul
     display:none con cui il browser nasconde il contenuto di un <details>
     chiuso, e il blocco resterebbe sempre aperto. */
  .collapsible[open] .collapsible__body {
    display: block;
    /* Filetto di stacco tra la barra e il contenuto: le fasce interne hanno
       un bordo proprio, quindi qui non serve altro. */
    border-top: 2px solid var(--color-black);
  }

  /* Variante "accent": barra e bordo rossi invece che neri, testo/icona
     bianchi (il rosso su rosso sparirebbe) - completamente diversa dalle
     altre fasce nere, per segnalare che Under 25 e' un'offerta a parte. */
  .collapsible--accent {
    border-color: var(--color-red);
    background: var(--color-red);
  }
  .collapsible--accent .collapsible__bar {
    background: var(--color-red);
  }
  .collapsible--accent .collapsible__title,
  .collapsible--accent .collapsible__icon {
    color: var(--color-white);
  }
  .collapsible--accent .collapsible__bar:hover .collapsible__title,
  .collapsible--accent .collapsible__bar:hover .collapsible__icon {
    color: var(--color-black);
  }
  .collapsible--accent[open] .collapsible__body {
    border-top-color: var(--color-white);
  }
</style>
