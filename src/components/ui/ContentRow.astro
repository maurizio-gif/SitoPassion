---
// Riga full-bleed con immagine su un lato e testo sull'altro. L'alternanza
// destra/sinistra e' automatica (:nth-of-type) come nella sezione "programmi"
// della home: righe dispari immagine a sinistra, righe pari immagine a destra.
// Va usata dentro <ContentRows>.
//
// nth-of-type e non nth-child: lo script differito piu' sotto viene
// deduplicato da Astro e finisce come fratello diretto delle <article> dentro
// <ContentRows> (non dentro questo file), sfasando di uno il conteggio dei
// figli. nth-of-type conta solo tra elementi dello stesso tag (<article>),
// quindi resta corretto anche con quello script in mezzo.
//
//   <ContentRows>
//     <ContentRow title="Titolo" image="/images/..." alt="...">
//       Paragrafo con **grassetto**.
//     </ContentRow>
//   </ContentRows>
interface Props {
  title?: string;
  image?: string;
  video?: string;
  alt?: string;
}

const { title, image, video, alt = '' } = Astro.props;

// Fermo immagine del video, per convenzione in /images/poster/ con lo stesso
// nome del file video. Serve perche' il video non parte piu' al caricamento
// (vedi lo script in fondo): senza, il riquadro resterebbe vuoto finche' non
// lo si raggiunge scorrendo. Generati con `scripts/genera-poster.sh`.
const poster = video
  ? `/images/poster/${video.split('/').pop()!.replace(/\.[^.]+$/, '')}.webp`
  : undefined;
---

<article class="content-row">
  <div class="content-row__media" data-parallax={!video}>
    {video
      ? <video
          src={video}
          poster={poster}
          preload="none"
          muted
          loop
          playsinline
          data-video-differito
        />
      : <img src={image} alt={alt} loading="lazy" />}
  </div>
  <div class="content-row__copy">
    {title && <h2>{title}</h2>}
    <div class="content-row__text">
      <slot />
    </div>
  </div>
</article>

<style>
  .content-row {
    display: grid;
    /* 50/50 esatto: e' quello che fa coincidere l'angolo dell'immagine di
       una riga con quello della riga successiva (che ha l'immagine sul lato
       opposto). Con colonne asimmetriche il confine si sposta a seconda
       della riga e gli angoli non si toccano piu'. */
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    /* min-height, non height: gli angoli si toccano grazie al 50/50 + zero
       gap (l'angolo basso-destro dell'immagine di una riga cade sullo stesso
       punto di quello alto-sinistro della riga dopo, a prescindere dalle
       altezze). Lasciare crescere la riga evita la barra di scorrimento
       interna sulle pagine con piu' testo di questa. */
    min-height: 30rem;
    /* Direzione da cui entra il titolo: righe dispari (testo a destra)
       entrano da destra, righe pari (testo a sinistra) da sinistra. */
    --enter-from: 3.5rem;
  }
  .content-row:nth-of-type(even) {
    --enter-from: -3.5rem;
  }
  .content-row__media {
    position: relative;
    overflow: hidden;
    /* Nessun bordo: il confine tra media e testo e' una sfumatura (vedi
       .content-row__copy::before piu' sotto), non una linea netta. */
  }
  .content-row__media img {
    position: absolute;
    /* Piu' alta del riquadro (che resta fermo, overflow:hidden): lo spazio
       in eccesso e' il margine in cui l'immagine puo' scorrere verticalmente
       allo scroll (vedi lo script data-parallax in BaseLayout). */
    inset: -15% 0;
    width: 100%;
    height: 130%;
    object-fit: cover;
    will-change: transform;
  }
  /* Il video e' gia' un contenuto in movimento: nessun parallasse, riempie
     semplicemente il riquadro (che resta della stessa dimensione di quello
     con l'immagine, essendo lo stesso .content-row__media). */
  .content-row__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Velo scuro fisso sul video (mai in fade come le gallery in hover):
     un video a piena luminosita' in loop stanca la vista piu' di una
     foto statica. */
  .content-row__media:has(video)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }
  .content-row__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    /* Sulle righe pari il media ha order:2 (per finire dal lato giusto) e
       quindi dipinge dopo il testo: senza z-index coprirebbe la sfumatura
       che sborda dal lato del testo. */
    z-index: 2;
  }
  /* Passaggio morbido tra testo e media: una sfumatura nel colore del box
     esce dal lato che tocca il media e vi si stende sopra. Parte dal
     colore pieno del box, altrimenti al confine si vede uno scalino. */
  .content-row__copy::before {
    content: "";
    position: absolute;
    inset-block: 0;
    width: min(7rem, 14%);
    pointer-events: none;
  }
  .content-row:nth-of-type(odd) .content-row__copy::before {
    right: 100%;
    background: linear-gradient(
      to left,
      var(--bg-light-soft) 0%,
      var(--bg-light-soft-half) 45%,
      var(--bg-light-soft-transparent) 100%
    );
  }
  .content-row:nth-of-type(even) .content-row__copy::before {
    left: 100%;
    background: linear-gradient(
      to right,
      var(--bg-light-soft) 0%,
      var(--bg-light-soft-half) 45%,
      var(--bg-light-soft-transparent) 100%
    );
  }
  /* La CTA dentro il testo non deve leggersi come un box dentro un box:
     nessuno sfondo, nessun bordo, solo scritta e freccia. */
  .content-row__text :global(.button),
  .content-row__text :global(.button:hover) {
    background: transparent;
    color: var(--text-on-light);
    border-color: transparent;
    padding-inline: 0;
  }
  .content-row__copy h2 {
    color: var(--color-red);
    opacity: 0;
    transform: translateX(var(--enter-from));
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .content-row__text {
    opacity: 0;
    transition: opacity 0.8s ease 0.15s;
  }
  .content-row.is-visible .content-row__copy h2 {
    opacity: 1;
    transform: none;
  }
  .content-row.is-visible .content-row__text {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .content-row__copy h2,
    .content-row__text {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Righe pari: immagine a destra. Va spostata anche la traccia, non solo
     l'ordine visivo, altrimenti su griglie asimmetriche l'immagine
     resterebbe nella colonna sbagliata. */
  .content-row:nth-of-type(even) .content-row__media {
    order: 2;
  }

  /* Il testo slottato arriva dal file .mdx, quindi ha lo scope del genitore:
     serve :global() per raggiungerlo da qui. Selettore a due classi di
     proposito: il componente deve restare padrone della propria tipografia
     anche se un domani PostBody tornasse a definire regole discendenti. */
  .content-row .content-row__text :global(p) {
    color: var(--text-on-light);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .content-row .content-row__text :global(p + p) {
    margin-top: var(--space-sm);
  }
  .content-row .content-row__text :global(strong) {
    color: var(--color-red);
  }
  .content-row .content-row__text :global(a) {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }

  /* + totem: vedi «Il totem verticale del club» in styles/global.css */
  @media (max-width: 860px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .content-row,
    .content-row:nth-of-type(even) {
      grid-template-columns: 1fr;
      /* Su mobile le righe sono impilate, non affiancate: l'altezza fissa
         del desktop (serve solo a far coincidere gli angoli in orizzontale)
         non serve piu', l'immagine torna a un rapporto proprio. */
      height: auto;
    }
    /* Ordine mobile: titolo, media, testo. Il titolo si stacca dal box del
       paragrafo (display:contents su .content-row__copy: i suoi due figli
       diventano item della griglia della riga) e diventa una fascia rossa
       sopra al media, uguale per righe pari e dispari. */
    .content-row__copy {
      display: contents;
    }
    .content-row__copy h2,
    .content-row:nth-of-type(even) .content-row__copy h2 {
      order: 1;
      margin: 0;
      background: var(--accent);
      color: var(--color-white);
      padding: var(--space-sm) var(--container-gutter);
      /* Fascia a piena larghezza: l'ingresso laterale la farebbe sforare
         dal viewport (e la pagina scorrerebbe in orizzontale). Solo fade. */
      transform: none;
      position: relative;
      /* Il media e' il fratello successivo e dipinge sopra a chiunque non
         abbia un proprio z-index: senza questo la sfumatura resta coperta. */
      z-index: 2;
    }
    /* Qui media e testo sono impilati, quindi la sfumatura scende dal
       titolo sul video invece di uscire di lato. */
    .content-row__copy h2::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      top: 100%;
      height: min(5rem, 10vh);
      background: linear-gradient(
        to bottom,
        var(--accent) 0%,
        var(--accent-quarter) 45%,
        var(--accent-transparent) 100%
      );
      pointer-events: none;
    }
    /* Su mobile il testo e' impilato sotto il media: la sfumatura
       orizzontale del desktop non ha senso. */
    .content-row__copy::before {
      content: none;
    }
    .content-row__media,
    .content-row:nth-of-type(even) .content-row__media {
      order: 2;
      aspect-ratio: 4 / 3;
    }
    /* Nessun bordo nemmeno qui: il passaggio col media sopra e' la
       sfumatura che scende dal titolo. */
    .content-row__text,
    .content-row:nth-of-type(even) .content-row__text {
      order: 3;
      background: var(--bg-light-soft);
      padding: var(--space-md) var(--container-gutter);
    }
  }
</style>

<script>
  /* Perche' non `autoplay`: con `autoplay muted` il browser scarica il video
     per poterlo far partire, e lo fa per TUTTI i video della pagina appena
     questa carica — anche per quelli che stanno sotto la piega e che molti
     visitatori non raggiungono mai. Sulla home erano quattro video scaricati
     in blocco al primo caricamento.

     Con `preload="none"` non viene chiesto un byte finche' non si chiama
     play(), e play() lo chiamiamo quando il riquadro entra davvero nello
     schermo. Fuori dallo schermo mettiamo in pausa: un video in loop che
     nessuno vede consuma CPU e batteria.

     Il poster (attributo `poster`) copre l'attesa fra "entra nello schermo" e
     "il video ha abbastanza dati per partire", ed e' anche cio' che resta
     visibile se JavaScript non gira. */
  const video = document.querySelectorAll<HTMLVideoElement>('video[data-video-differito]');

  if (video.length) {
    // Senza IntersectionObserver (browser molto vecchi) si torna al
    // comportamento di prima: partono tutti subito. Meglio pesante che vuoto.
    if (!('IntersectionObserver' in window)) {
      video.forEach((v) => {
        v.preload = 'auto';
        v.muted = true;
        v.play().catch(() => {});
      });
    } else {
      const osservatore = new IntersectionObserver(
        (voci) => {
          voci.forEach((voce) => {
            const v = voce.target as HTMLVideoElement;
            if (voce.isIntersecting) {
              // `muted` anche da JS: Safari guarda la proprieta', non solo
              // l'attributo, per decidere se una riproduzione automatica e'
              // ammessa senza un gesto dell'utente.
              v.muted = true;
              v.play().catch(() => {});
            } else {
              v.pause();
            }
          });
        },
        // Un quarto di schermo di margine: il video comincia a caricare poco
        // prima di entrare in vista, cosi' all'arrivo e' gia' in movimento,
        // ma non cosi' presto da tirarne giu' tre in una volta (con mezzo
        // schermo di margine le righe, essendo adiacenti, partivano a
        // gruppi). Nell'attesa il riquadro mostra il poster, quindi anticipare
        // troppo non serve.
        { rootMargin: '25% 0px' },
      );
      video.forEach((v) => osservatore.observe(v));
    }
  }
</script>
