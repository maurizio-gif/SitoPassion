---
// Fascia con l'orario settimanale di un corso/attivita'.
//
// Due letture dello stesso markup, senza duplicare i contenuti:
// - desktop: una colonna per giorno, ogni giorno impila i propri slot
//   (esattamente come nel planning cartaceo della palestra, dove i giorni
//   hanno un numero diverso di lezioni);
// - mobile: un giorno per volta, scelto dalle tab in alto o dalle frecce in
//   basso. Sei colonne su un telefono sono illeggibili, e lo scroll
//   orizzontale nasconde meta' del planning.
//
//   <ScheduleSection
//     title="Corsi Energy"
//     text="Paragrafo introduttivo (opzionale). Accetta <strong> per il grassetto rosso."
//     tone="blush"                                   (opzionale)
//     days={[
//       { label: 'Lunedì', slots: [{ time: 'H. 07:00', name: 'Hyrox' }, ...] },
//       ...
//     ]}
//   />
interface Slot {
  time: string;
  name: string;
}

interface Day {
  label: string;
  slots: Slot[];
}

interface Props {
  title: string;
  text?: string;
  days: Day[];
  // Ancora per i link diretti al planning (usata dal menu mobile).
  id?: string;
  // L'alternanza bianco/rosa e' decisa dalla pagina e non da :nth-of-type:
  // il conteggio dipenderebbe da quante altre <section> ci sono attorno.
  tone?: 'plain' | 'blush';
}

const { title, text, days, id, tone = 'plain' } = Astro.props;
---

<section
  class:list={["schedule", { "schedule--blush": tone === 'blush' }]}
  id={id}
  data-schedule
  data-reveal
>
  <div class="container">
    <h2 class="schedule__title">{title}</h2>
    {text && <p class="schedule__intro" set:html={text} />}

    {/* Solo mobile: selettore del giorno. */}
    <div class="schedule__tabs">
      {days.map((day, i) => (
        <button
          class:list={["schedule__tab", { "is-active": i === 0 }]}
          type="button"
          data-day={i}
          aria-pressed={i === 0}
        >
          {day.label.slice(0, 3)}
        </button>
      ))}
    </div>

    <div class="schedule__grid" style={`--cols: ${days.length}`}>
      {days.map((day, i) => (
        <div
          class:list={["schedule__day", { "is-active": i === 0 }]}
          data-label={day.label}
        >
          <span class="schedule__day-label">{day.label}</span>
          {day.slots.map((slot) => (
            <div class="schedule__slot">
              <span class="schedule__slot-time">{slot.time}</span>
              <span class="schedule__slot-name">{slot.name}</span>
            </div>
          ))}
        </div>
      ))}
    </div>

    {/* Solo mobile: giorno corrente e frecce per scorrere. */}
    <div class="schedule__nav">
      <button class="schedule__nav-btn" type="button" data-dir="-1" aria-label="Giorno precedente">
        <span aria-hidden="true">‹</span>
      </button>
      <span class="schedule__nav-label" aria-live="polite">{days[0]?.label}</span>
      <button class="schedule__nav-btn" type="button" data-dir="1" aria-label="Giorno successivo">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>
</section>

<script>
  // Un solo script per tutti gli orari della pagina (Astro lo raggruppa una
  // volta sola): ogni sezione tiene il proprio giorno attivo.
  document.querySelectorAll('[data-schedule]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('.schedule__tab'));
    const days = Array.from(root.querySelectorAll<HTMLElement>('.schedule__day'));
    const label = root.querySelector('.schedule__nav-label');
    if (days.length === 0) return;

    let current = 0;

    const show = (next: number) => {
      // Modulo con offset: dalle frecce si passa da sabato a lunedi' e
      // viceversa senza vicoli ciechi.
      current = (next + days.length) % days.length;
      tabs.forEach((tab, i) => {
        tab.classList.toggle('is-active', i === current);
        tab.setAttribute('aria-pressed', String(i === current));
      });
      days.forEach((day, i) => day.classList.toggle('is-active', i === current));
      if (label) label.textContent = days[current]?.dataset.label ?? '';
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));
    root.querySelectorAll<HTMLElement>('.schedule__nav-btn').forEach((btn) => {
      btn.addEventListener('click', () => show(current + Number(btn.dataset.dir)));
    });
  });
</script>

<style>
  .schedule {
    padding-block: var(--space-lg);
  }
  .schedule--blush {
    background: var(--bg-light-soft);
  }
  .schedule__title {
    color: var(--color-red);
  }
  .schedule__intro {
    max-width: 46rem;
    margin-top: var(--space-xs);
    color: var(--text-on-light);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .schedule__intro :global(strong) {
    color: var(--color-red);
    font-weight: 700;
  }

  /* Ingresso allo scroll: titolo, testo e planning salgono insieme. */
  .schedule__title,
  .schedule__intro,
  .schedule__grid,
  .schedule__tabs,
  .schedule__nav {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .schedule__intro {
    transition-delay: 0.08s;
  }
  .schedule__tabs,
  .schedule__grid,
  .schedule__nav {
    transition-delay: 0.16s;
  }
  .schedule.is-visible .schedule__title,
  .schedule.is-visible .schedule__intro,
  .schedule.is-visible .schedule__grid,
  .schedule.is-visible .schedule__tabs,
  .schedule.is-visible .schedule__nav {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .schedule__title,
    .schedule__intro,
    .schedule__grid,
    .schedule__tabs,
    .schedule__nav {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .schedule__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    /* Gap strettissimo tra le colonne: lo spazio guadagnato va ai riquadri,
       che devono restare leggibili anche con sei giorni affiancati. */
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }
  .schedule__day {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .schedule__day-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    color: var(--text-on-light);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-3xs);
    border-bottom: 2px solid var(--color-black);
  }
  .schedule__slot {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    background: var(--color-black);
    color: var(--color-white);
    /* Angoli squadrati come il resto del sito (bordi, card, bottoni). */
    border-radius: 0;
    padding: 0.75em 0.8em;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .schedule__slot:hover {
    background: var(--accent);
    transform: translateY(-2px);
  }
  .schedule__slot-time {
    color: var(--color-red);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }
  /* In hover il riquadro e' rosso: l'ora in rosso sparirebbe. */
  .schedule__slot:hover .schedule__slot-time {
    color: var(--color-white);
  }
  .schedule__slot-name {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(0.95rem, 1.35vw, 1.15rem);
    line-height: 1.1;
  }

  /* Tab e frecce servono solo alla vista mobile. */
  .schedule__tabs,
  .schedule__nav {
    display: none;
  }

  /* --- Mobile: un giorno per volta --- */
  /* Il totem NON eredita questa vista (eccezione alla regola generale, vedi
     «Il totem verticale del club» in global.css): a differenza di due colonne
     di prosa, una griglia di orari con celle strette regge bene anche larga,
     e il totem ha lo spazio per mostrarla come il desktop - un giorno alla
     volta sprecherebbe un intero schermo di reception per una sola colonna.
     Vedi il blocco dedicato piu' sotto per gli adattamenti di dimensione. */
  @media (max-width: 860px) {
    .schedule {
      /* Leggermente piu' compatto tra una categoria e l'altra. */
      padding-block: 2.5rem;
      /* Contiene lo scorrimento laterale di titolo/box qui sotto: senza
         questo, l'elemento traslato sforerebbe dal proprio riquadro e
         allargherebbe il layout viewport, con la pagina che scorre in
         orizzontale (bug gia' visto altrove sul sito). */
      overflow: hidden;
    }
    /* Fascia rossa col titolo bianco, come i titoli di ContentRow su mobile. */
    .schedule__title {
      background: var(--accent);
      color: var(--color-white);
      padding: var(--space-sm) var(--space-md);
      margin-inline: calc(-1 * var(--container-gutter));
    }

    .schedule__tabs {
      display: flex;
      margin-top: var(--space-md);
      border: 2px solid var(--color-black);
      border-bottom: none;
    }
    .schedule__tab {
      flex: 1 1 0;
      min-width: 0;
      appearance: none;
      background: var(--color-white);
      border: none;
      border-right: 1px solid var(--color-black);
      padding: 0.85rem 0.2rem;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-on-light);
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .schedule__tab:last-child {
      border-right: none;
    }
    .schedule__tab.is-active {
      background: var(--accent);
      color: var(--color-white);
    }

    .schedule__grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 0;
    }
    /* Fuori dal giorno attivo niente e' visibile: il planning del giorno
       riempie la larghezza dello schermo invece di stare in una colonna da
       7rem con lo scroll orizzontale. */
    .schedule__day {
      display: none;
      gap: 0;
      border-inline: 2px solid var(--color-black);
      background: var(--color-black);
    }
    .schedule__day.is-active {
      display: flex;
    }
    /* Il giorno e' scritto nelle tab e nella barra sotto: qui sarebbe la
       terza volta. */
    .schedule__day-label {
      display: none;
    }
    /* Da riquadro a riga: ora a sinistra su colonna fissa, nome del corso
       accanto, cosi' gli orari restano incolonnati e leggibili di fila.
       Box nero, corso rosso, orario bianco: l'hover (che su touch resta
       agganciato al dito) e' disattivato, il tocco usa :active. */
    .schedule__slot {
      flex-direction: row;
      align-items: center;
      gap: var(--space-sm);
      background: var(--color-black);
      color: var(--color-white);
      border-bottom: 1px solid var(--border-on-dark);
      padding: 0.9rem var(--space-sm);
    }
    .schedule__slot:last-child {
      border-bottom: none;
    }
    .schedule__slot:hover {
      background: var(--color-black);
      transform: none;
    }
    .schedule__slot-time {
      flex-shrink: 0;
      width: 4.75rem;
      font-size: 0.95rem;
      color: var(--color-white);
    }
    .schedule__slot:hover .schedule__slot-time {
      color: var(--color-white);
    }
    .schedule__slot-name {
      font-size: 1.15rem;
      color: var(--color-red);
    }
    /* "Attivi" (il tocco) restano rossi, come l'hover desktop. */
    .schedule__slot:active {
      background: var(--accent);
    }
    .schedule__slot:active .schedule__slot-name {
      color: var(--color-white);
    }

    .schedule__nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
      border: 2px solid var(--color-black);
      background: var(--color-black);
      padding: var(--space-2xs);
    }
    .schedule__nav-btn {
      appearance: none;
      width: 2.5rem;
      height: 2.5rem;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-white);
      border: none;
      color: var(--color-black);
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
    }
    .schedule__nav-label {
      font-family: var(--font-display);
      text-transform: uppercase;
      font-size: 1.25rem;
      line-height: 1;
      color: var(--color-white);
    }

    /* Ingresso laterale: il titolo scorre da sinistra, il planning (tab +
       box + barra dei giorni) da destra. L'overflow:hidden qui sopra su
       .schedule contiene lo sbordamento durante l'animazione. */
    @media (prefers-reduced-motion: no-preference) {
      .schedule__title {
        transform: translateX(-3.5rem);
      }
      .schedule__tabs,
      .schedule__grid,
      .schedule__nav {
        transform: translateX(3.5rem);
      }
      .schedule.is-visible .schedule__title,
      .schedule.is-visible .schedule__tabs,
      .schedule.is-visible .schedule__grid,
      .schedule.is-visible .schedule__nav {
        transform: none;
      }
    }
  }
</style>
