---
// Blocco prezzi di una categoria: griglia 2x2 dentro il container del sito.
// Prima cella nera col nome della categoria, le attività comprese e le
// condizioni; le altre tre celle sono le durate (o i prodotti) con prezzo e
// CTA.
//
// La griglia sta nel container (non full-bleed) perche' titoli e paragrafi
// delle sezioni sono allineati li': una fascia edge-to-edge partirebbe piu' a
// sinistra e romperebbe l'incolonnamento della pagina.
//
// Serve sia per gli abbonamenti sia per i prodotti a prezzo secco (accesso
// singolo, pacchetti Personal Training): `duration` diventa l'etichetta del
// prodotto e `priceSuffix=""` toglie il "al mese".
//
//   <PricingGroup
//     title="Open"
//     subtitle="Reformer, Sala Pesi, Corsi Fitness"
//     features={['Accesso senza limiti orari', ...]}   (opzionale)
//     plans={[
//       { duration: '12 mesi', price: '87', href: '...' },
//       { duration: '4 mesi', price: '97', href: '...' },
//       { duration: 'Flex', price: '119', href: '...' },
//     ]}
//     priceSuffix="al mese"                            (opzionale, default "al mese")
//     buttonLabel="Iscriviti Ora"                      (opzionale)
//     note="Quota di attivazione una tantum 60€. ..."  (opzionale, va nella cella nera)
//     image="/images/..."     (opzionale: sfondo a tutta larghezza dietro la
//                               sezione, con velo scuro e ombra sotto la
//                               griglia per farla risaltare sopra la foto)
//   />
interface Plan {
  duration: string;
  price: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  features?: string[];
  plans: Plan[];
  priceSuffix?: string;
  buttonLabel?: string;
  note?: string;
  // Ancora per i link diretti al gruppo (usata dal menu mobile).
  id?: string;
  image?: string;
}

const {
  title,
  subtitle,
  features = [],
  plans,
  priceSuffix = 'al mese',
  buttonLabel = 'Iscriviti Ora',
  note,
  id,
  image,
} = Astro.props;
---

<section class:list={['pricing', { 'pricing--has-bg': !!image }]} id={id}>
  {image && (
    <div class="pricing__bg" style={`background-image: url(${image})`} aria-hidden="true"></div>
  )}
  <div class="container">
    <div class="pricing__grid">
      <div class="pricing__head">
        <h3 class="pricing__title">{title}</h3>
        {subtitle && <p class="pricing__subtitle">{subtitle}</p>}
        {features.length > 0 && (
          <>
            <p class="eyebrow pricing__label">Attività comprese</p>
            <ul class="pricing__features">
              {features.map((feature) => (
                <li>
                  <span class="pricing__mark" aria-hidden="true">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        {note && <p class="pricing__note">{note}</p>}
      </div>

      {plans.map((plan) => (
        <div class="pricing__plan">
          <span class="pricing__duration">{plan.duration}</span>
          <span class="pricing__amount">
            <span class="pricing__price">{plan.price}<span class="pricing__currency">€</span></span>
            {priceSuffix && <span class="pricing__suffix">{priceSuffix}</span>}
          </span>
          <a class="pricing__cta" href={plan.href}>{buttonLabel}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Aria attorno al blocco: le categorie si susseguono e senza respiro la
     pagina diventa un muro di riquadri. */
  .pricing {
    padding-block: var(--space-md);
    position: relative;
  }
  /* Sfondo a tutta larghezza della sezione (solo con `image`): copre da bordo
     a bordo perche' la sezione stessa non e' contenuta in un .container, solo
     il suo contenuto lo e'. Velo nero fisso per leggibilita' del testo sopra,
     indipendentemente da quanto e' chiara la foto. */
  .pricing__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }
  /* Sfumatura invece di velo piatto: si scurisce quasi al nero pieno sopra e
     sotto, cosi' il taglio tra la foto di una categoria e quella della
     categoria successiva (o la fascia nera/rossa sotto) sparisce in un unico
     bordo scuro invece di un cambio di immagine brusco. */
  .pricing__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.55) 15%,
      rgba(0, 0, 0, 0.55) 85%,
      rgba(0, 0, 0, 0.92) 100%
    );
  }
  .pricing--has-bg {
    /* Spazio in piu' sopra/sotto: sulla sola griglia nera il padding stretto
       va bene, ma qui deve respirare anche la foto che la circonda. */
    padding-block: var(--space-xl);
  }
  .pricing--has-bg .container {
    position: relative;
    z-index: 1;
  }
  /* Rilievo della griglia sopra la foto di sfondo: senza ombra il nero della
     griglia si fonderebbe visivamente col velo scuro della foto. */
  .pricing--has-bg .pricing__grid {
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  /* Se una fascia Collapsible segue subito una categoria con sfondo foto (es.
     Under 25 dopo "Sala Pesi"), niente margine tra le due: altrimenti ci
     spunta in mezzo lo sfondo chiaro della pagina. */
  .pricing--has-bg + :global(.collapsible) {
    margin-top: 0;
  }
  .pricing__grid {
    display: grid;
    /* 2x2: cella nera + tre durate. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Separatori dati dal gap sul fondo nero, come nelle altre fasce. */
    gap: 2px;
    background: var(--color-black);
    border: 2px solid var(--color-black);
    /* Padding interno delle celle. La griglia esce dal container esattamente
       di questo valore (margin-inline negativo): cosi' il TESTO delle celle
       cade sulla colonna del container, dove stanno titoli e paragrafi delle
       sezioni. Con un container piu' strettodel padding la griglia arriva al
       massimo a filo schermo, senza mai sfondare. */
    --cell-pad: var(--space-md);
    /* +2px: anche il bordo della griglia sta fuori dal container, altrimenti
       il testo delle celle resterebbe indietro di 2px. */
    margin-inline: calc(-1 * (var(--cell-pad) + 2px));
  }

  .pricing__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-black);
    color: var(--color-white);
    padding: var(--space-md) var(--cell-pad);
  }
  .pricing .pricing__title {
    color: var(--color-red);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }
  .pricing .pricing__subtitle {
    /* Bianco pieno e non il grigio attenuato: qui e' l'unico testo secondario
       del riquadro, il grigio si legge solo come scritta spenta. */
    color: var(--color-white);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .pricing__label {
    margin-top: var(--space-2xs);
    color: var(--color-red);
  }
  /* Elenco in colonna: nella cella c'e' altezza in abbondanza e le voci non
     si spezzano piu' a meta' riga. */
  .pricing__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .pricing .pricing__features li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin: 0;
    padding-inline-start: 0;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--color-white);
  }
  /* La spunta e' l'unico marcatore: neutralizza il pallino delle liste di
     PostBody, che vincerebbe per specificita'. */
  .pricing .pricing__features li::before {
    content: none;
  }
  .pricing__mark {
    flex-shrink: 0;
    color: var(--color-red);
    font-weight: 700;
  }
  /* Condizioni in fondo alla cella: margin-top:auto le tiene incollate al
     bordo inferiore anche quando la cella si allunga per pareggiare la riga. */
  .pricing .pricing__note {
    margin: 0;
    margin-top: auto;
    padding-top: var(--space-sm);
    /* Bianco pieno, non il grigio attenuato: vedi pricing__subtitle sopra. */
    color: var(--color-white);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .pricing__plan {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-3xs);
    background: var(--bg-light-soft);
    padding: var(--space-md) var(--space-sm);
    transition: background-color 0.2s ease;
  }
  /* Numero dispari di celle: l'ultima si allarga sulla riga, altrimenti resta
     un buco nero nella griglia. Qui la cella nera occupa una colonna, quindi
     il totale e' dispari quando i piani sono pari. */
  .pricing__plan:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .pricing__plan:hover {
    background: var(--accent);
  }
  .pricing__duration {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.1;
    color: var(--text-on-light);
    transition: color 0.2s ease;
  }
  .pricing__amount {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pricing__price {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.5vw, 3.6rem);
    line-height: 1;
    color: var(--color-red);
    transition: color 0.2s ease;
  }
  .pricing__currency {
    font-size: 0.55em;
    vertical-align: 0.35em;
    margin-inline-start: 0.05em;
  }
  .pricing__suffix {
    font-size: 0.82rem;
    color: var(--text-on-light);
    transition: color 0.2s ease;
  }
  /* In hover la cella e' rossa: rosso su rosso sparirebbe. */
  .pricing__plan:hover .pricing__duration,
  .pricing__plan:hover .pricing__price,
  .pricing__plan:hover .pricing__suffix {
    color: var(--color-white);
  }

  .pricing__cta {
    margin-top: var(--space-sm);
    background: var(--accent);
    color: var(--color-white);
    border: 2px solid var(--accent);
    padding: 0.8rem 1.3rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .pricing__plan:hover .pricing__cta {
    background: var(--color-white);
    color: var(--color-red);
    border-color: var(--color-white);
  }
  .pricing__cta:hover {
    background: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  /* + totem: vedi «Il totem verticale del club» in styles/global.css */
  @media (max-width: 860px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .pricing {
      padding-block: var(--space-sm);
    }
    .pricing__grid {
      /* Una cella per riga: gli abbonamenti si leggono uno sotto l'altro. */
      grid-template-columns: 1fr;
      /* 18px e non 20: il rientro della griglia e' cell-pad + 2 di bordo e
         non deve superare il padding del container (20px sui telefoni),
         altrimenti la pagina scorre in orizzontale. */
      --cell-pad: 1.125rem;
    }
    .pricing__head {
      padding: var(--space-sm) var(--cell-pad);
    }
    .pricing__plan {
      /* Box piu' alti: a piena larghezza il contenuto e' poco e senza
         un'altezza minima le celle si schiacciano su tre righe di testo. */
      min-height: 13rem;
      padding: var(--space-md) var(--cell-pad);
    }
    /* In colonna singola non ci sono buchi da riempire. */
    .pricing__plan:last-child:nth-child(odd) {
      grid-column: auto;
    }
    .pricing__duration {
      font-size: 1.3rem;
    }
    .pricing__price {
      font-size: 2.8rem;
    }
    .pricing__cta {
      width: 100%;
      max-width: 22rem;
    }
    /* L'hover su touch resta agganciato al dito: la cella rossa rimarrebbe
       rossa dopo il tap. Il feedback lo da' :active. */
    .pricing__plan:hover {
      background: var(--bg-light-soft);
    }
    .pricing__plan:hover .pricing__duration,
    .pricing__plan:hover .pricing__suffix {
      color: var(--text-on-light);
    }
    .pricing__plan:hover .pricing__price {
      color: var(--color-red);
    }
    .pricing__plan:hover .pricing__cta {
      background: var(--accent);
      color: var(--color-white);
      border-color: var(--accent);
    }
    .pricing__plan:active {
      background: var(--accent);
    }
    .pricing__plan:active .pricing__duration,
    .pricing__plan:active .pricing__price,
    .pricing__plan:active .pricing__suffix {
      color: var(--color-white);
    }
  }
</style>
