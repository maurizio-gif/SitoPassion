---
import { getEntry } from 'astro:content';

const footer = await getEntry('footerSettings', 'footer');
const site = await getEntry('siteSettings', 'site');
const data = footer?.data;
const socials = site?.data.socials ?? {};
const year = new Date().getFullYear();

/* Etichetta e tracciato per ogni social. L'etichetta non si vede piu' a
   schermo — al suo posto c'e' l'icona — ma resta come `aria-label`: un link
   il cui unico contenuto e' un'icona, per chi usa un lettore di schermo, e'
   un link senza nome.

   I tracciati sono i marchi ufficiali su griglia 24. Stanno qui e non nel
   markup perche' il ciclo che disegna i link e' uno: con le icone scritte
   inline servirebbe un `if` per ognuna. Una chiave che non ha un tracciato
   ricade sul testo, cosi' aggiungere un social a `site.json` non lascia un
   buco muto nel footer. */
const SOCIALS: Record<string, { label: string; path: string }> = {
  instagram: {
    label: 'Instagram',
    path: 'M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .5 1.4.95.45.44.73.83.95 1.4.17.44.36 1.05.42 2.2C21.99 8.4 22 8.8 22 12s0 3.6-.07 4.9c-.06 1.2-.25 1.8-.42 2.2-.22.6-.5 1-.95 1.4-.44.45-.83.73-1.4.95-.44.17-1.05.36-2.2.42-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.42-.6-.22-1-.5-1.4-.95-.45-.44-.73-.83-.95-1.4-.17-.44-.36-1.05-.42-2.2C2.01 15.6 2 15.2 2 12s0-3.6.07-4.9c.06-1.2.25-1.8.42-2.2.22-.6.5-1 .95-1.4.44-.45.83-.73 1.4-.95.44-.17 1.05-.36 2.2-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.73.07-.95.04-1.4.2-1.72.32-.36.14-.6.3-.87.56-.26.27-.42.5-.56.87-.13.33-.28.77-.32 1.72C3.74 8.77 3.73 9.1 3.73 12s.01 3.23.07 4.46c.4.95.19 1.4.32 1.72.14.36.3.6.56.87.27.26.5.42.87.56.33.13.77.28 1.72.32 1.23.06 1.58.07 4.73.07s3.5-.01 4.73-.07c.95-.04 1.4-.19 1.72-.32.36-.14.6-.3.87-.56.26-.27.42-.51.56-.87.13-.32.28-.77.32-1.72.06-1.23.07-1.56.07-4.46s-.01-3.23-.07-4.46c-.04-.95-.19-1.4-.32-1.72a2.3 2.3 0 0 0-.56-.87 2.3 2.3 0 0 0-.87-.56c-.32-.13-.77-.28-1.72-.32-1.23-.06-1.58-.07-4.73-.07Zm0 3.1a5.9 5.9 0 1 1 0 11.8 5.9 5.9 0 0 1 0-11.8Zm0 1.8a4.1 4.1 0 1 0 0 8.2 4.1 4.1 0 0 0 0-8.2Zm6.1-2.1a1.35 1.35 0 1 1-2.7 0 1.35 1.35 0 0 1 2.7 0Z',
  },
  facebook: {
    label: 'Facebook',
    path: 'M13.5 21.9v-8.2h2.8l.4-3.2h-3.2V8.4c0-.93.26-1.56 1.6-1.56h1.7V4c-.3-.04-1.32-.13-2.5-.13-2.48 0-4.18 1.51-4.18 4.29v2.39H7.3v3.2h2.82v8.2h3.38Z',
  },
  youtube: {
    label: 'YouTube',
    path: 'M21.6 7.2c-.23-.86-.9-1.53-1.76-1.76C18.25 5 12 5 12 5s-6.25 0-7.84.44c-.86.23-1.53.9-1.76 1.76C2 8.79 2 12 2 12s0 3.21.4 4.8c.23.86.9 1.53 1.76 1.76C5.75 19 12 19 12 19s6.25 0 7.84-.44c.86-.23 1.53-.9 1.76-1.76.4-1.59.4-4.8.4-4.8s0-3.21-.4-4.8ZM10 15.1V8.9l5.2 3.1-5.2 3.1Z',
  },
};

// Enti e certificazioni: presentazione, quindi restano qui e non nei dati.
const PARTNERS = [
  { src: '/images/uploads/2024/10/coni.png', alt: 'CONI' },
  { src: '/images/uploads/2024/10/ciwas-300x204-1.png', alt: 'CIWAS' },
  { src: '/images/uploads/2024/10/ASI.png', alt: 'ASI' },
  { src: '/images/uploads/2024/10/logo-anif.png', alt: 'ANIF' },
  { src: '/images/uploads/2024/10/fitnesswa.png', alt: 'FitnessWay' },
];

const MAPS_SRC =
  'https://maps.google.com/maps?q=PASSION%20FITNESS%20TUSCOLANA&t=m&z=15&output=embed&iwloc=near';

/* Il link WhatsApp con il messaggio gia' scritto: chi apre la chat da qui
   trova la prima riga pronta e non deve inventarsela. `wa.me` invece di
   `api.whatsapp.com/send`, che e' la forma che stava nella pagina contatti:
   e' l'indirizzo breve ufficiale, apre l'app se c'e' e il web se non c'e',
   e non porta i tre parametri di servizio che quell'altro si trascina. */
const WHATSAPP_TESTO = encodeURIComponent(
  'Ciao! Vorrei avere maggiori informazioni su Passion Fitness.'
);
const whatsappHref = data?.whatsapp
  ? `https://wa.me/${data.whatsapp}?text=${WHATSAPP_TESTO}`
  : null;

/* Il numero come si legge, non come si compone: `06 767 4709`. Nel dato sta
   in cifre attaccate perche' quella e' la forma che serve a `tel:` e a
   `wa.me`, ma un numero da leggere a schermo si spezza — e spezzarlo qui,
   una volta, evita di tenere due campi allineati a mano. */
const telefonoLeggibile = data?.phone
  ? data.phone.replace(/^(\d{2})(\d{3})(\d{4})$/, '$1 $2 $3')
  : null;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand">
          <img src="/images/logo-passionfitness.png" alt="Passion Fitness Club" width="402" height="174" />
        </a>
        {data?.description && <p class="footer-brand__claim">{data.description}</p>}
        {Object.keys(socials).length > 0 && (
          <ul class="footer-socials">
            {Object.entries(socials).map(([name, url]) => {
              const social = SOCIALS[name];
              return (
                <li>
                  <a href={url} aria-label={social?.label ?? name}>
                    {social ? (
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d={social.path} />
                      </svg>
                    ) : (
                      name
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>

      <div class="footer-col">
        <h4 class="eyebrow">Palestra</h4>
        <ul>
          <li><a href="/palestra/sala-pesi/">Sala Pesi</a></li>
          <li><a href="/palestra/corsi-fitness/">Corsi Fitness</a></li>
          <li><a href="/personal-training/">Personal Training</a></li>
          <li><a href="/pilates-reformer/">Pilates Reformer</a></li>
          <li><a href="/hyrox/">Hyrox</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="eyebrow">Informazioni</h4>
        <ul>
          <li><a href="/orari-corsi/">Orari Corsi</a></li>
          <li><a href="/abbonamenti/">Abbonamenti</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contatti/">Contattaci</a></li>
        </ul>
      </div>

      {/* I contatti in una colonna loro, con le tre voci etichettate. Prima
          telefono ed email stavano in coda all'elenco sotto la mappa, senza
          etichetta e senza WhatsApp: chi cercava un modo di scrivere al club
          leggeva «Dove siamo» e passava oltre. */}
      <div class="footer-col">
        <h4 class="eyebrow">Contatti</h4>
        <ul class="footer-contatti">
          {data?.phone && (
            <li>
              <a href={`tel:+39${data.phone}`}>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z" />
                </svg>
                <span>{telefonoLeggibile}</span>
              </a>
            </li>
          )}
          {whatsappHref && (
            <li>
              <a href={whatsappHref}>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.4A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 0 1 0 16.4 8.1 8.1 0 0 1-4.2-1.2l-.3-.2-2.8.8.8-2.7-.2-.3A8.2 8.2 0 0 1 12 3.8Zm-3 4c-.2 0-.5.1-.7.3-.3.3-.8.8-.8 1.8s.7 2 .8 2.2c.1.2 1.4 2.3 3.5 3.1 1.7.7 2.1.6 2.5.5.5 0 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1 0-.1-.2-.2-.4-.3l-1.4-.7c-.2-.1-.4-.1-.5.1l-.6.7c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-1.9-1.2 7.3 7.3 0 0 1-1.3-1.7c-.1-.2 0-.3.1-.4l.5-.6c.1-.2.2-.3.1-.5l-.6-1.4c-.1-.3-.3-.3-.4-.3H9Z" />
                </svg>
                <span>Scrivici su WhatsApp</span>
              </a>
            </li>
          )}
          {data?.email && (
            <li>
              <a href={`mailto:${data.email}`}>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m2.5 6 9.5 6.5L21.5 6" />
                </svg>
                <span>{data.email}</span>
              </a>
            </li>
          )}
        </ul>
        {/* Gli orari non sono il quarto contatto: sono un'altra informazione,
            e stavano attaccati all'email con lo stesso stile — «Dal Lunedi'
            alla Domenica» in grassetto sembrava un altro link. Qui hanno una
            loro etichetta e un loro riquadro, e l'orario e' il numero grande
            perche' e' quello che si viene a cercare. */}
        {data?.openingHours && data.openingHours.length > 0 && (
          <div class="footer-orari">
            <span class="footer-orari__label">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.5V12l3 2" />
              </svg>
              Siamo aperti
            </span>
            <ul>
              {data.openingHours.map((o) => (
                <li>
                  <span class="footer-orari__giorni">{o.day}</span>
                  <span class="footer-orari__ore">{o.hours}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="footer-col">
        <h4 class="eyebrow">Dove siamo</h4>
        <div class="footer-map">
          <iframe
            src={MAPS_SRC}
            title="Passion Fitness Tuscolana su Google Maps"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <ul>
          {data?.address && <li>{data.address}</li>}
        </ul>
      </div>
    </div>

    {data?.careersUrl && (
      <div class="footer-careers">
        <p>Passion Fitness è alla ricerca di personale: lavora con noi.</p>
        <a class="footer-careers__cta" href={data.careersUrl}>
          Inviaci il tuo CV
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )}

    <ul class="footer-partners">
      {PARTNERS.map((p) => (
        <li><img src={p.src} alt={`Logo ${p.alt}`} loading="lazy" /></li>
      ))}
    </ul>

    <div class="footer-legal">
      {data?.legalNotice && <p>{data.legalNotice}</p>}
      <p class="footer-legal__ids">
        {data?.vatNumber && <span>C.F. / P.IVA {data.vatNumber}</span>}
        {data?.registryNumber && <span>{data.registryNumber}</span>}
      </p>
    </div>

    <div class="footer-bottom">
      <span>© {year} Passion Fitness — Palestra Roma Tuscolana</span>
      <span class="footer-bottom__links">
        <a href="/informativa-privacy/">Informativa privacy</a>
        <a href="/informativa-estesa-sullutilizzo-dei-cookie/">Cookie Policy</a>
        {/* Riapre il pannello delle preferenze di CookieYes. La classe
            `cky-banner-element` e' il gancio che il loro script cerca da se',
            quindi qui non serve nessun gestore: se lo script non c'e' — per
            esempio in locale, dove CookieYes rifiuta il dominio — il link
            semplicemente non fa niente invece di dare errore.

            Non e' un vezzo: il consenso deve poter essere revocato con la
            stessa facilita' con cui e' stato dato, e senza questo comando la
            sola strada era cancellare i cookie dal browser. */}
        <a href="#" class="cky-banner-element">Preferenze cookie</a>
        {/* Era un link al vecchio sito, e portava direttamente al PDF: una
            pagina che la legge chiede di pubblicare non puo' vivere fuori dal
            sito ed essere leggibile solo scaricando un allegato. Ora e' una
            pagina nostra, col PDF in fondo. */}
        <a href="/mog-e-codice-di-condotta/">MOG e Codice di Condotta</a>
      </span>
    </div>

    <div class="footer-poweredby">
      <span>Powered by</span>
      <a href="https://ready2digital.it/" target="_blank" rel="noopener">
        <img src="/images/uploads/2026/09/ready2digital-logo.png" alt="Ready2Digital" width="993" height="192" loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    color: var(--text-on-dark);
    padding-block: var(--space-lg) var(--space-md);
  }

  /* Il footer occupa la larghezza intera, mentre il resto del sito sta dentro
     i 76rem del contenitore. Non e' un'incoerenza: il fondo scuro arriva
     comunque da bordo a bordo, e con il contenuto fermo al centro su uno
     schermo largo restavano due fasce nere vuote ai lati piu' larghe delle
     colonne stesse — il footer sembrava un riquadro appoggiato su una pagina
     piu' grande.
     `:global` perche' `.container` non e' una classe di questo file: gli stili
     con ambito di Astro appenderebbero l'attributo di scope al selettore e non
     troverebbero il `div` che arriva da global.css. I margini laterali restano
     quelli di tutto il sito, cosi' il testo non tocca il vetro. */
  .site-footer :global(.container) {
    max-width: none;
  }

  .brand {
    display: inline-flex;
  }
  .brand img {
    height: 4.75rem;
    width: auto;
  }

  /* Cinque colonne da quando i contatti hanno la loro: marchio, due elenchi,
     contatti, mappa. Il marchio si e' stretto per far posto — il suo claim ha
     comunque un `max-width` suo — e la mappa resta la piu' larga delle
     quattro, perche' sotto una certa misura non si legge piu'. */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr 1.1fr 1.2fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
  }
  .footer-brand__claim {
    margin-top: var(--space-xs);
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
    max-width: 22rem;
    line-height: 1.5;
  }
  .footer-col h4 {
    color: var(--text-on-dark-muted);
    margin-bottom: var(--space-xs);
  }
  .footer-col ul,
  .footer-socials,
  .footer-hours,
  .footer-contatti {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.88rem;
  }
  .footer-col a:hover,
  .footer-socials a:hover {
    color: var(--color-red);
  }
  /* Le icone social: quadrati bordati e non tre parole in maiuscolo. Il
     bersaglio e' 2.5rem — sotto i 40px si sbaglia col pollice — e il bordo
     serve a dire che sono toccabili: un'icona sola, senza contorno, su fondo
     nero si legge come decorazione. */
  .footer-socials {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
  }
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--border-on-dark);
    border-radius: 10px;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .footer-socials a:hover {
    color: var(--color-white);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Icona e testo su una riga, con l'icona che non si stringe: senza
     `flex-shrink: 0` un'email lunga la schiaccerebbe invece di andare a capo
     da sola. Il colore dell'icona e' quello del testo — `currentColor` nei
     tracciati — quindi passa al rosso in hover senza una regola in piu'. */
  /* Righe tutte uguali: stessa altezza, icona incolonnata, testo che parte
     dallo stesso punto. Prima erano tre `inline-flex` di altezze diverse
     perche' il testo di ognuna e' lungo diverso, e le icone risultavano
     leggermente sfalsate. */
  .footer-contatti {
    gap: 0.15rem;
  }
  .footer-contatti a {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.25rem;
    /* L'indirizzo email su una riga sola: spezzato a meta' — «info@passionfit»
       / «ness.it» — non si legge piu' come un indirizzo. Ci sta: nella colonna
       piu' stretta del footer misura meno della larghezza disponibile. */
    white-space: nowrap;
  }
  .footer-contatti svg {
    justify-self: center;
    color: var(--color-red);
  }
  .footer-contatti a:hover svg {
    color: inherit;
  }

  .footer-map {
    margin-bottom: var(--space-xs);
    border: 2px solid var(--border-on-dark);
    overflow: hidden;
  }
  .footer-map iframe {
    display: block;
    width: 100%;
    height: 9rem;
    border: none;
    /* La mappa a colori pieni su fondo nero spicca troppo rispetto al resto
       del footer: leggermente desaturata si integra senza perdere leggibilita'. */
    filter: grayscale(0.35);
  }
  /* Il riquadro degli orari: staccato dai contatti da un fondo suo, non solo
     da un margine. Con il solo margine restava un blocco di testo in mezzo ad
     altro testo, e a colpo d'occhio non si distingueva. */
  .footer-orari {
    margin-top: var(--space-sm);
    padding: var(--space-xs);
    background: var(--bg-dark-surface);
    border-radius: 10px;
  }
  .footer-orari__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .footer-orari ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .footer-orari__giorni {
    display: block;
    font-size: 0.78rem;
    color: var(--text-on-dark-muted);
  }
  /* L'orario e' il dato che si viene a cercare, quindi e' il piu' grande
     della colonna dopo il titolo. */
  .footer-orari__ore {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--text-on-dark);
  }

  /* Fascia "lavora con noi": si distingue dal resto senza diventare una
     sezione a se', da qui il solo filetto sopra e sotto. */
  .footer-careers {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--border-on-dark);
  }
  .footer-careers p {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    line-height: 1.1;
  }
  .footer-careers__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--color-red);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .footer-careers__cta span {
    transition: transform 0.15s ease;
  }
  .footer-careers__cta:hover span {
    transform: translateX(3px);
  }

  .footer-partners {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }
  .footer-partners img {
    height: 2.25rem;
    width: auto;
    /* I loghi degli enti sono di colori diversi tra loro: in bianco su fondo
       nero restano leggibili e non fanno a pugni col resto. */
    filter: grayscale(1) brightness(1.8);
    opacity: 0.7;
  }

  .footer-legal {
    padding-block: var(--space-sm);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-on-dark-muted);
  }
  .footer-legal__ids {
    display: flex;
    flex-wrap: wrap;
